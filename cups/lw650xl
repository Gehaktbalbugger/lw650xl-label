#!/bin/sh
# lw650xl - CUPS filter wrapper (CUPS raster -> TSPL for the LW650XL PRO).
#
# cupsd starts filters in a restricted context where /usr/bin/python3 (the
# Xcode stub) cannot resolve /var/select/developer_dir, so the real Python
# interpreter is selected explicitly. The conversion itself lives in
# lw650xl.py next to this script.
#
# The fallback list covers: Xcode Command Line Tools, Homebrew (Apple
# Silicon and Intel), python.org installs, and finally the system stub.

SELF_DIR=/usr/libexec/cups/filter
if [ ! -r "$SELF_DIR/lw650xl.py" ]; then
    case "$0" in
        */*) SELF_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd) ;;
        *)   SELF_DIR=. ;;
    esac
fi

for py in \
    /Library/Developer/CommandLineTools/usr/bin/python3 \
    /opt/homebrew/bin/python3 \
    /usr/local/bin/python3 \
    /Library/Frameworks/Python.framework/Versions/Current/bin/python3 \
    /usr/bin/python3
do
    if [ -x "$py" ]; then
        exec "$py" "$SELF_DIR/lw650xl.py" "$@"
    fi
done

echo "lw650xl: geen werkende Python 3 gevonden" >&2
exit 1
