#!/usr/bin/env python3
"""measure - calibrate a new label roll in two commands.

    ./measure 36 89 --name LW_36x89 --pitch 93 --gap 4      # print the measuring label
    ./measure solve --N -49 --Z 40 --W -18 --O 18           # reading -> add-size.sh

    ./measure 26 25 --markers                               # T/B/L/R frame sheet
    ./measure solve --T 2 --B 2.03 --L 1.96 --R 2.01        # white per letter

    ./measure plumb 25 25 --xoffset -2.5                     # cut plumb-line sheet
    ./measure plumb 25 25 --xoffset -2.5 --report 0.5        # ...and new xoffset

The measuring label shows a cross with 0,0 in the middle of the ASSUMED
printable area, 1-mm ticks with numbers and the letters N Z W O on the
expected label edges. Read off the printed label which mm value falls on the
four real edges and hand those to `solve`; it converts them into `left`,
`right`, `top` and `bottom` and prints the add-size.sh command.

On rotated rolls that scale fails (figures outside the label, directions
turned around — see KNOWLEDGE §4A). `--markers` therefore prints a single
frame on the edges of the printable area with one letter per side, each with
its crown toward its own label edge; you read only the white between frame
and label edge per letter and `solve --T .. --B .. --L .. --R ..` converts
that, mapped per rotation.

De geometrie komt uit dezelfde code als de CUPS-filter (cups/lw650xl.py), dus
what was measured here is what the driver does later.

Opties print:   --name/--pitch/--gap/--left/--right/--top/--bottom/--voffset
                --host/--port/--preview/--dry-run/--state
Opties solve:   --N --Z --W --O  (mm op de schaal, genummerd vanaf 0,0)
                --desc --size-mm --optioneel dezelfde rolwaarden als bij het printen
"""
import argparse
import importlib.util
import json
import os
import re
import socket
import struct
import sys
import time

HERE = os.path.dirname(os.path.abspath(__file__))
FILTER_PATH = os.path.join(HERE, "cups", "lw650xl.py")
PPD_PATHS = (os.path.join(HERE, "cups", "lw650xl-labels.ppd"),
             "/etc/cups/ppd/LW650XL_Labels.ppd")
DEFAULT_STATE = "/tmp/lw650xl-measure.json"
DEFAULT_HOST = "172.16.1.20"


def load_filter():
    spec = importlib.util.spec_from_file_location("lw650xl_measure", FILTER_PATH)
    mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)
    return mod


def size_name(w_mm, h_mm):
    return f"LW_{w_mm:g}x{h_mm:g}"


def resolve_geometry(lw, args):
    """Geometry from the PPD (if the size is known) with command-line overrides."""
    table = lw.load_ppd_media(PPD_PATHS)
    opts = {}
    # ALWAYS send media, even for unknown rolls: otherwise media_geometry
    # normalizes the page dims (long side = width) and swaps portrait sizes —
    # the whole measuring sheet then comes out sideways on paper (bug of the
    # unmeasured PPD sizes, found on S0904980).
    opts["media"] = args.name or size_name(args.w, args.h)
    for key in ("pitch", "gap", "voffset", "left", "right", "top", "bottom",
                "rotate", "rows", "xoffset"):
        value = getattr(args, key.replace("-", "_"), None)
        if value is not None:
            opts[f"lw-{key}"] = str(value)
    if opts.get("media") not in table:
        # unknown roll: assume the label starts at the head's left edge
        opts.setdefault("lw-left", args.left if args.left is not None else 0)
        opts.setdefault("lw-top", args.top if args.top is not None else 5.1)
    geom = lw.media_geometry(opts, args.w, args.h, table)
    return geom, table


def design_image(lw, geom, centre_mm, step=1):
    """The measuring image: exact label size with cross, mm scale and N Z W O."""
    from PIL import Image, ImageDraw, ImageFont
    dpm = lw.DOTS_PER_MM
    W = int(round(geom.size_w * dpm))
    H = int(round(geom.size_h * dpm))
    img = Image.new("L", (W, H), 255)
    d = ImageDraw.Draw(img)

    def font(sz, bold=True):
        for p in ("/System/Library/Fonts/Supplemental/Arial Bold.ttf" if bold
                  else "/System/Library/Fonts/Supplemental/Arial.ttf",
                  "/System/Library/Fonts/Supplemental/Arial.ttf"):
            try:
                return ImageFont.truetype(p, sz)
            except Exception:
                pass
        return ImageFont.load_default()

    cx, cy = centre_mm[0] * dpm, centre_mm[1] * dpm   # 0,0 in pagina-coordinaten
    small, big = font(int(2.6 * dpm), False), font(int(4.5 * dpm))

    # ticks along both arms: every `step` mm, numbers at multiples of 5
    for i in range(-int(geom.size_w), int(geom.size_w), step):
        x = cx + i * dpm
        if not (2 < x < W - 2):
            continue
        major = i % 5 == 0
        d.line([(x, cy - (18 if major else 9) * dpm / 2),
                (x, cy + (18 if major else 9) * dpm / 2)], fill=0, width=2)
        if major and i:
            t = str(i)
            bb = d.textbbox((0, 0), t, font=small)
            d.text((x - (bb[2] - bb[0]) / 2, cy + 11 * dpm / 2), t, font=small, fill=0)
    for i in range(-int(geom.size_h), int(geom.size_h), step):
        y = cy + i * dpm
        if not (2 < y < H - 2):
            continue
        major = i % 5 == 0
        d.line([(cx - (18 if major else 9) * dpm / 2, y),
                (cx + (18 if major else 9) * dpm / 2, y)], fill=0, width=2)
        if major and i and abs(i) % 10 == 0:
            t = str(i)
            bb = d.textbbox((0, 0), t, font=small)
            d.text((cx + 11 * dpm / 2, y - (bb[3] - bb[1]) / 2), t, font=small, fill=0)

    # assen + kruispunt
    d.line([(cx, 2), (cx, H - 2)], fill=0, width=1)
    d.line([(2, cy), (W - 2, cy)], fill=0, width=1)
    r = 5 * dpm / 2
    d.ellipse([cx - r, cy - r, cx + r, cy + r], outline=0, width=3)
    d.text((cx + 8, cy - 30), "0,0", font=small, fill=0)

    # frames at 10, 14, 18 mm ... for a double reading
    for half in (10, 15):
        d.rectangle([cx - half * dpm, cy - half * dpm,
                     cx + half * dpm, cy + half * dpm], outline=0, width=2)

    # compass letters on the assumed label edges
    for (px, py, ch) in ((cx, 2, "N"), (cx, H - int(4.5 * dpm) - 2, "Z"),
                         (2, cy - int(4.5 * dpm) / 2, "W"),
                         (W - int(4.5 * dpm) - 4, cy - int(4.5 * dpm) / 2, "O")):
        d.text((px, py), ch, font=big, fill=0)
    note = (f"0,0 op {centre_mm[0]:.1f}/{centre_mm[1]:.1f} mm  "
            f"w={geom.left:g} r={geom.right:g} t={geom.top:g} b={geom.bottom:g}")
    bb = d.textbbox((0, 0), note, font=font(2.2 * dpm, False))
    if bb[2] - bb[0] < W:
        d.text(((W - (bb[2] - bb[0])) / 2, H - bb[3] - 2), note,
               font=font(2.2 * dpm, False), fill=0)
    return img


def as_raster(lw, img):
    """Wrap a PIL gray image in the cgpdftoraster RaS3 layout."""
    W, H = img.size
    hdr = bytearray(1796)
    struct.pack_into("<II", hdr, 0x114, 300, 300)
    struct.pack_into("<II", hdr, 0x174, W, H)
    gray = img.convert("L").tobytes()
    return lw.MAGIC + bytes(hdr) + gray


# ---- --markers: the T/B/L/R sheet (lesson of the square roll, KNOWLEDGE §4A) --
# A frame IMMEDIATELY on the edges of the printable area plus one letter
# per side, crown toward its own label edge. No numbers, no numbered scale,
# no cross: those are unreadable and direction-less at rotate=270. The user
# holds the label the way they read it and says how many mm of white sit
# between frame and edge per letter; solve converts that, mapped per
# rotation, into left/right/top/bottom and the true size.
# letters -> canvas-rand per rotatie (§4A: bij 270 is boven de kleine x,
# links de grote y; 90 is het spiegelbeeld, voor zover bekend ongeijkt):
MARKER_EDGES = {
    0:   {"T": "top", "B": "bottom", "L": "left", "R": "right"},
    90:  {"T": "right", "B": "left", "L": "top", "R": "bottom"},
    270: {"T": "left", "B": "right", "L": "bottom", "R": "top"},
}
EDGE_TURN = {"top": 0, "left": 90, "bottom": 180, "right": -90}


def markers_image(lw, cw, ch, rotate):
    """Frame on the window edges + T B L R, each with the crown toward its own
    edge; drawn in canvas orientation, so sent without rotation."""
    from PIL import Image, ImageDraw, ImageFont
    dpm = lw.DOTS_PER_MM
    img = Image.new("L", (cw, ch), 255)
    d = ImageDraw.Draw(img)
    d.rectangle([1, 1, cw - 2, ch - 2], outline=0, width=3)
    try:
        fo = ImageFont.truetype(
            "/System/Library/Fonts/Supplemental/Arial Bold.ttf", int(4.0 * dpm))
    except Exception:
        fo = ImageFont.load_default()
    inset = 3.0 * dpm                      # from frame line to letter box
    edges = MARKER_EDGES.get(int(rotate) % 360, MARKER_EDGES[0])
    for letter, edge in edges.items():
        g = Image.new("L", (int(8 * dpm), int(6 * dpm)), 255)
        gd = ImageDraw.Draw(g)
        bb = gd.textbbox((0, 0), letter, font=fo)
        gd.text(((g.width - (bb[2] - bb[0])) / 2 - bb[0],
                 (g.height - (bb[3] - bb[1])) / 2 - bb[1]), letter, font=fo, fill=0)
        if EDGE_TURN[edge]:
            g = g.rotate(EDGE_TURN[edge], expand=True, fillcolor=255)
        if edge == "top":
            pos = ((cw - g.width) / 2, inset)
        elif edge == "bottom":
            pos = ((cw - g.width) / 2, ch - inset - g.height)
        elif edge == "left":
            pos = (inset, (ch - g.height) / 2)
        else:
            pos = (cw - inset - g.width, (ch - g.height) / 2)
        img.paste(g, (int(pos[0]), int(pos[1])))
    return img


def _markers_howto(state_path):
    print("Hold the label the way you READ it and measure, per letter, the white")
    print("between the frame line and the label edge; then:")
    print("  ./measure solve --T <mm> --B <mm> --L <mm> --R <mm>")
    print(f"(measure data: {state_path})")


def cmd_markers(lw, args):
    """Print the marker sheet: frame = assumed printable area, drawn in canvas
    coordinates and sent without rotation so it lands 1:1 on the window."""
    geom, _ = resolve_geometry(lw, args)
    target_h = lw.canvas_rows(geom)
    ox, oy, cw, ch = lw.print_window(geom, target_h)
    img = markers_image(lw, cw, ch, geom.rotate)

    opts = {"media": args.name or size_name(args.w, args.h),
            "lw-pitch": repr(geom.pitch), "lw-gap": repr(geom.gap),
            "lw-voffset": repr(geom.voffset), "lw-left": repr(geom.left),
            "lw-right": repr(geom.right), "lw-top": repr(geom.top),
            "lw-bottom": repr(geom.bottom),
            "lw-rotate": "0",          # het vel zelf is al canvas-georiënteerd
            "lw-orient": "off",        # ook de auto-draai uit: 1:1 op het venster
            "lw-rows": repr(geom.rows), "lw-xoffset": repr(geom.xoffset)}
    payload = lw.convert(as_raster(lw, img), opts)
    dpm = lw.DOTS_PER_MM
    state = {
        "mode": "markers", "w": args.w, "h": args.h,
        "name": args.name or size_name(args.w, args.h),
        "rotate": int(geom.rotate),
        "frame": {"x0": round(ox / dpm, 3), "x1": round((ox + cw) / dpm, 3),
                  "y0": round(oy / dpm, 3), "y1": round((oy + ch) / dpm, 3)},
        "geometry": {"pitch": geom.pitch, "gap": geom.gap, "voffset": geom.voffset,
                     "left": geom.left, "right": geom.right, "top": geom.top,
                     "bottom": geom.bottom, "rows": geom.rows,
                     "rotate": geom.rotate, "xoffset": geom.xoffset},
    }
    with open(args.state, "w") as f:
        json.dump(state, f, indent=1)
    frame_note = (f"frame = printable area x {ox / dpm:.2f}..{(ox + cw) / dpm:.2f} mm, "
                  f"y {oy / dpm:.2f}..{(oy + ch) / dpm:.2f} mm "
                  f"(roll rotates {int(geom.rotate)} degrees).")
    if args.preview:
        img.save(args.preview)
        print(f"preview: {args.preview} ({cw}x{ch} dots)")
    if args.preview and not args.dry_run:
        print(f"not printed (--preview); TSPL is {len(payload)} bytes")
        print(frame_note)
        _markers_howto(args.state)
        return 0
    if args.dry_run:
        print(f"DRY-RUN: {len(payload)} bytes to {args.host}:{args.port}")
        print(re.sub(rb"\r\n", b" | ", payload[:160]).decode("latin-1") + " ...")
        print(frame_note)
        _markers_howto(args.state)
        return 0
    s = socket.create_connection((args.host, args.port), timeout=5)
    s.settimeout(20)
    s.sendall(payload)
    chunks = []
    t0 = time.time()
    try:
        while time.time() - t0 < 20:
            b = s.recv(4096)
            if not b:
                break
            chunks.append(b)
    except socket.timeout:
        pass
    s.close()
    print("printer:", b"".join(chunks)[:120].decode("latin-1").strip())
    print(frame_note)
    _markers_howto(args.state)
    return 0


def cmd_ladder(lw, args):
    """Print numbered 4 mm bands across one full feed step.

    The printer starts at a fixed spot after finding the gap; on a roll with a
    large spacing part of that feed ends up behind the label. With the bands
    one label shows where the label begins: the band falling on the top edge,
    times 4 mm = the offset.
    """
    from PIL import Image, ImageDraw, ImageFont
    dpm = lw.DOTS_PER_MM
    rows = int(round(args.pitch * dpm)) - 12
    W = int(round(args.w * dpm))
    img = Image.new("L", (W, rows), 255)
    d = ImageDraw.Draw(img)
    try:
        fo = ImageFont.truetype("/System/Library/Fonts/Supplemental/Arial Bold.ttf",
                                int(4.5 * dpm))
    except Exception:
        fo = ImageFont.load_default()
    step = args.band
    for i, y0 in enumerate(range(0, rows, int(step * dpm))):
        y1 = min(y0 + int(step * dpm) - int(0.8 * dpm), rows - 1)
        d.rectangle([int(1 * dpm), y0, W - int(1 * dpm), y1], outline=0, width=2)
        d.text((int(2.5 * dpm), y0 + int(0.6 * dpm)), str(i + 1), font=fo, fill=0)
    opts = {"media": args.name or size_name(args.w, args.h),
            "lw-pitch": str(args.pitch), "lw-gap": str(args.gap if args.gap is not None else 3.0)}
    payload = lw.convert(as_raster(lw, img), opts)
    if args.dry_run or args.preview:
        if args.preview:
            img.save(args.preview)
        print(f"ladder: {rows} rijen, banden van {step:g} mm, {len(payload)} bytes"
              + (" (not printed)" if args.preview and not args.dry_run else ""))
        return 0
    sock = socket.create_connection((args.host, args.port), timeout=5)
    sock.settimeout(20)
    sock.sendall(payload)
    chunks, t0 = [], time.time()
    try:
        while time.time() - t0 < 20:
            b = sock.recv(4096)
            if not b:
                break
            chunks.append(b)
    except socket.timeout:
        pass
    sock.close()
    print("printer:", b"".join(chunks)[:80].decode("latin-1").strip())
    print(f"bands of {step:g} mm, {rows} rows ({rows / dpm:.1f} mm) fed.")
    print("Say which band falls on the top edge of the label and which on the bottom.")
    return 0


def cmd_plumb(lw, args):
    """Cut plumb line for 2-up and shifted rolls: a line IN the expected cut
    groove plus two reference dots on the lane centers. Reading: if the line
    deviates by d mm, positive toward A (left). New xoffset = old + d. One
    feed, one number — the lesson of the AM11353 (boxes gave 10 mm, the
    plumb pinned 0.5)."""
    geom, _ = resolve_geometry(lw, args)
    target_h = lw.canvas_rows(geom)
    ox, oy, cw, ch = lw.print_window(geom, target_h)
    from PIL import Image, ImageDraw
    dpm = lw.DOTS_PER_MM
    img = Image.new("L", (cw, ch), 255)
    d = ImageDraw.Draw(img)
    mid = cw // 2
    d.rectangle((mid - 1, int(5 * dpm), mid + 1, ch - int(5 * dpm)), fill=0)
    for cx in (cw // 4, 3 * cw // 4):
        d.rectangle((cx - 6, ch // 2 - 6, cx + 6, ch // 2 + 6), fill=0)

    opts = {"media": args.name or size_name(args.w, args.h),
            "lw-pitch": repr(geom.pitch), "lw-gap": repr(geom.gap),
            "lw-voffset": repr(geom.voffset), "lw-left": repr(geom.left),
            "lw-right": repr(geom.right), "lw-top": repr(geom.top),
            "lw-bottom": repr(geom.bottom), "lw-rotate": "0",
            "lw-orient": "off", "lw-rows": repr(geom.rows),
            "lw-xoffset": repr(geom.xoffset)}
    payload = lw.convert(as_raster(lw, img), opts)

    print(f"plumb at x {(ox + mid) / dpm:.2f} mm (frame {ox / dpm:.2f}.."
          f"{(ox + cw) / dpm:.2f}); puntjes op de baanmiddens.")
    if args.report is not None:
        new_x = geom.xoffset + args.report
        print(f"reading {args.report:+g} mm (positive = line on A): "
              f"xoffset {geom.xoffset:g} -> {new_x:.2f}")
        print(f"  ./add-size.sh {args.name or size_name(args.w, args.h)} "
              f"\"blok {args.w:g}x{args.h:g} mm\" {args.w:g} {args.h:g} "
              f"--pitch {geom.pitch:g} --gap {geom.gap:g} --xoffset {new_x:.2f}")
        print("sudo /Users/Shared/Labelprinter/setup/install.sh")
        return 0
    if args.dry_run:
        print(f"DRY-RUN: {len(payload)} bytes to {args.host}:{args.port}")
        return 0
    if args.preview:
        img.save(args.preview)
        print(f"preview: {args.preview} ({cw}x{ch} dots)")
        return 0
    s = socket.create_connection((args.host, args.port), timeout=5)
    s.settimeout(20)
    s.sendall(payload)
    chunks = []
    t0 = time.time()
    try:
        while time.time() - t0 < 20:
            b = s.recv(4096)
            if not b:
                break
            chunks.append(b)
    except socket.timeout:
        pass
    s.close()
    print("printer:", b"".join(chunks)[:80].decode("latin-1").strip())
    print("Say how many mm the line deviates from the cut groove; positive if")
    print("it sits on A (left of the rail):  ./measure plumb <w> <h> --report <d>")


def cmd_print(lw, args):
    """Print the calibration label and remember where its 0,0 sits."""
    geom, _ = resolve_geometry(lw, args)
    target_h = int(round(geom.pitch * lw.DOTS_PER_MM)) - 12
    ox, oy, cw, ch = lw.print_window(geom, target_h)
    centre = ((ox + cw / 2) / lw.DOTS_PER_MM, (oy + ch / 2) / lw.DOTS_PER_MM)

    img = design_image(lw, geom, centre, args.step)
    if args.preview:
        img.save(args.preview)
        print(f"preview: {args.preview} ({img.width}x{img.height} dots)")

    # send exactly the geometry computed above; otherwise the printer feeds
    # differently from what the image assumes and the readings are useless.
    opts = {"media": args.name or size_name(args.w, args.h),
            "lw-pitch": repr(geom.pitch), "lw-gap": repr(geom.gap),
            "lw-voffset": repr(geom.voffset), "lw-left": repr(geom.left),
            "lw-right": repr(geom.right), "lw-top": repr(geom.top),
            "lw-bottom": repr(geom.bottom), "lw-rotate": repr(geom.rotate),
            "lw-rows": repr(geom.rows), "lw-xoffset": repr(geom.xoffset)}
    payload = lw.convert(as_raster(lw, img), opts)
    state = {
        "w": args.w, "h": args.h, "name": args.name or size_name(args.w, args.h),
        "centre_x_mm": round(centre[0], 2), "centre_y_mm": round(centre[1], 2),
        "geometry": {"pitch": geom.pitch, "gap": geom.gap, "voffset": geom.voffset,
                     "left": geom.left, "right": geom.right, "top": geom.top,
                     "bottom": geom.bottom, "rows": geom.rows,
                     "rotate": geom.rotate},
    }
    with open(args.state, "w") as f:
        json.dump(state, f, indent=1)

    if args.preview and not args.dry_run:
        print(f"not printed (--preview); TSPL is {len(payload)} bytes")
        return 0
    if args.dry_run:
        print(f"DRY-RUN: {len(payload)} bytes to {args.host}:{args.port}")
        print(re.sub(rb"\r\n", b" | ", payload[:160]).decode("latin-1") + " ...")
        print(f"measure data: {args.state}")
        return 0

    s = socket.create_connection((args.host, args.port), timeout=5)
    s.settimeout(20)
    s.sendall(payload)
    chunks = []
    t0 = time.time()
    try:
        while time.time() - t0 < 20:
            b = s.recv(4096)
            if not b:
                break
            chunks.append(b)
    except socket.timeout:
        pass
    s.close()
    print("printer:", b"".join(chunks)[:120].decode("latin-1").strip())
    print(f"0,0 staat op {centre[0]:.1f} / {centre[1]:.1f} mm van de bitmap"
          + (f", beeld gedraaid {geom.rotate} graden." if geom.rotate else "."))
    if geom.rotate:
        print("Read the edges the way the label comes out of the printer: the")
        print("text axis runs along the feed direction.")
    print("Lees de vier randen af en doe:  ./measure solve --N .. --Z .. --W .. --O ..")
    print(f"(measure data: {args.state})")
    return 0


def cmd_solve_markers(lw, state, args):
    """solve on a marker sheet: four white readings (mm) back into add-size.sh.

    The letters sit in the roll's reading orientation; MARKER_EDGES converts
    them to canvas edges (§4A: at rotate=270 the T/B are the head side, L/R
    the feed). The frame was on the old printable area, so each reading is
    the white between that area and the true label edge.
    """
    frame, rot = state["frame"], int(state.get("rotate", 0))
    missing = [k for k in "TBLR" if getattr(args, k) is None]
    if missing:
        sys.exit("marker solve needs all four readings: "
                 + " ".join(f"--{k} <mm>" for k in missing))
    edges = MARKER_EDGES.get(rot % 360, MARKER_EDGES[0])
    gap = {edge: getattr(args, letter) for letter, edge in edges.items()}

    label_left = frame["x0"] - gap["left"]
    label_right = frame["x1"] + gap["right"]
    label_top = frame["y0"] - gap["top"]
    label_bottom = frame["y1"] + gap["bottom"]
    measured_w = label_right - label_left          # over de kop
    measured_h = label_bottom - label_top          # along the feed

    left = max(0.0, -label_left)                   # onbereikbare strook links
    right = max(lw.DEFAULT_RIGHT_MM, left) if left else lw.DEFAULT_RIGHT_MM
    top = label_top
    bottom = 2.0 * -label_top if label_top < 0 else lw.DEFAULT_BOTTOM_MM
    bottom = max(bottom, lw.DEFAULT_BOTTOM_MM)

    # the size for add-size.sh: in the roll's reading orientation (design
    # size), so along the feed at 90/270; rounded to 0.1 mm.
    if rot % 360 in (90, 270):
        size_w, size_h = round(measured_h, 1), round(measured_w, 1)
    else:
        size_w, size_h = round(measured_w, 1), round(measured_h, 1)

    pitch = args.pitch
    gap_mm = args.gap
    # no gap inference from pitch-minus-height: many rolls carry extra liner
    # around the notch (S0929120: 4+3+5) and the marker sheet cannot see it.

    name = args.name or state["name"]
    desc = args.desc or f"Etiket {size_w:g}x{size_h:g} mm (marker-vel)"
    cmd = f"./add-size.sh {name} \"{desc}\" {size_w:g} {size_h:g}"
    if pitch is not None:
        cmd += f" --pitch {pitch:g}"
    if gap_mm is not None:
        cmd += f" --gap {gap_mm:g}"
    if left:
        cmd += f" --left {left:g} --right {right:g}"
    if abs(top - lw.DEFAULT_TOP_MM) > 0.05:
        cmd += f" --top {top:g}"
    if abs(bottom - lw.DEFAULT_BOTTOM_MM) > 0.05:
        cmd += f" --bottom {bottom:g}"
    if args.voffset:
        cmd += f" --voffset {args.voffset:g}"
    geom = state.get("geometry", {})
    if geom.get("xoffset") and abs(label_left) > 1.0:
        cmd += f" --xoffset {label_left:g}"

    shift_x = (label_left + label_right) / 2 - (frame["x0"] + frame["x1"]) / 2
    shift_y = (label_top + label_bottom) / 2 - (frame["y0"] + frame["y1"]) / 2
    print(f"measured label: {measured_w:.2f} x {measured_h:.2f} mm "
          f"(across the head x feed; given: {state['w']:g} x {state['h']:g})")
    print(f"label lines in bitmap mm: x {label_left:.2f}..{label_right:.2f}, "
          f"y {label_top:.2f}..{label_bottom:.2f}")
    print(f"label middle vs the old area: {shift_x:+.2f} mm across the head, "
          f"{shift_y:+.2f} mm along the feed")
    if rot % 360 in (90, 270):
        print("this roll rotates: your T/B was counted across the head (left/right),")
        print("your L/R along the feed (top/bottom) — KNOWLEDGE §4A.")
    if abs(shift_x) > 0.3 or abs(shift_y) > 0.3:
        print("  -> the old area was not on the label center; the values above")
        print("     correct that.")
    if pitch is None:
        print("measure the pitch next (ladder mode or 20 labels / 20) and add")
        print("  --pitch <mm> [--gap <mm>]; it cannot be taken from one sheet.")
    elif gap_mm is None:
        print("gap: not derivable from this sheet; rolls often carry extra liner")
        print("  around the notch — pass --gap <mm> only if you know it.")
    if geom.get("xoffset") or left > 0:
        print("2-up/shift roll: afterwards verify the cut line with a")
        print("  plumb-line sheet (see KNOWLEDGE §AM11353).")
    print()
    print(cmd)
    print("sudo /Users/Shared/Labelprinter/setup/install.sh")
    return 0


def cmd_solve(lw, args):
    try:
        state = json.load(open(args.state))
    except OSError:
        sys.exit(f"no measure data in {args.state}; print ./measure <w> <h> first")
    if state.get("mode") == "markers":
        return cmd_solve_markers(lw, state, args)
    if args.w is None:
        args.w, args.h = state["w"], state["h"]
    cx, cy = state["centre_x_mm"], state["centre_y_mm"]

    dpm = lw.DOTS_PER_MM
    # labeled reading -> absolute position of the label relative to the bitmap
    label_left = cx + args.W
    label_right = cx + args.O
    label_top = cy + args.N
    label_bottom = cy + args.Z

    measured_w = label_right - label_left
    measured_h = label_bottom - label_top
    left = max(0.0, -label_left)                    # onbereikbaar deel links
    # Centreer door rechts evenveel in te leveren als links onbereikbaar is,
    # maar laat altijd een kleine veiligheidsrand.
    right = max(lw.DEFAULT_RIGHT_MM, left) if left else lw.DEFAULT_RIGHT_MM
    top = label_top
    # Rows below row 0 are unreachable: the label sticks out above the head.
    # With bottom = 2 x |top| the ink height becomes short enough to leave the
    # same deviation at the bottom too, so the image stands centered.
    bottom = 2.0 * -label_top if label_top < 0 else lw.DEFAULT_BOTTOM_MM
    bottom = max(bottom, lw.DEFAULT_BOTTOM_MM)
    # pitch and gap cannot be derived from the cross: only pass them through
    # when the user knows them, otherwise let add-size.sh take its defaults.
    pitch = args.pitch
    gap = args.gap
    if pitch is not None and gap is None:
        gap = round(pitch - measured_h, 1)

    name = args.name or state["name"]
    desc = args.desc or f"Etiket {measured_w:.0f}x{measured_h:.0f} mm"
    cmd = f"./add-size.sh {name} \"{desc}\" {args.w:g} {args.h:g}"
    if pitch is not None:
        cmd += f" --pitch {pitch:g}"
    if gap is not None:
        cmd += f" --gap {gap:g}"
    if left:
        cmd += f" --left {left:g} --right {right:g}"
    if abs(top - lw.DEFAULT_TOP_MM) > 0.05:
        cmd += f" --top {top:g}"
    if abs(bottom - lw.DEFAULT_BOTTOM_MM) > 0.05:
        cmd += f" --bottom {bottom:g}"
    if args.voffset:
        cmd += f" --voffset {args.voffset:g}"

    print(f"measured label: {measured_w:.2f} x {measured_h:.2f} mm "
          f"(opgave: {args.w:g} x {args.h:g} mm)")
    print(f"label lines in bitmap mm: x {label_left:.2f}..{label_right:.2f}, "
          f"y {label_top:.2f}..{label_bottom:.2f}")
    asym_w = abs(args.W + args.O)
    asym_h = abs(args.N + args.Z)
    print(f"centreringsfout: horizontaal {asym_w:.2f} mm, verticaal {asym_h:.2f} mm")
    if asym_w > 0.3 or asym_h > 0.3:
        print("  -> the 0,0 of the measuring image was not on the label center;")
        print("     the values above correct that.")
    if pitch is None:
        print("measure the pitch next (20 labels: total distance / 20) and add")
        print("  --pitch <mm> --gap <mm> toe; die zijn uit dit kruis niet te halen.")
    print()
    print(cmd)
    print("sudo /Users/Shared/Labelprinter/setup/install.sh")
    return 0


def main():
    lw = load_filter()
    ap = argparse.ArgumentParser(
        description="calibrate a label roll",
        epilog="./measure 36 89 --name LW_36x89   |   ./measure solve --N -49 --Z 40 --W -18 --O 18")
    ap.add_argument("positionals", nargs="*",
                    help="'solve' / 'ladder', of de maten: <breedte_mm> <hoogte_mm>")
    ap.add_argument("--name", help="PD-naam, bv. LW_36x89")
    ap.add_argument("--desc", help="omschrijving voor add-size.sh")
    for key, help_ in (("pitch", "pitch in mm"), ("gap", "gap between labels in mm"),
                       ("voffset", "print N mm lower"), ("left", "dead zone on the left in mm"),
                       ("right", "margin on the right in mm"), ("top", "label top edge in mm"),
                       ("bottom", "margin at the bottom in mm")):
        ap.add_argument("--" + key, type=float,
                        default=None if key != "voffset" else 0.0, help=help_)
    ap.add_argument("--rotate", type=int, default=None, choices=(0, 90, 270),
                    help="rotate the measuring image too, like this roll prints (PPD rotate=)")
    ap.add_argument("--xoffset", type=float, default=None,
                    help="mm tussen kopstart en linker rand van de liner (PPD xoffset=)")
    ap.add_argument("--rows", type=int, default=None,
                    help="bitmap-hoogte in dots; Labellife stuurt 356 voor deze rol")
    ap.add_argument("--band", type=float, default=4.0,
                    help="bandhoogte in mm voor de ladder-modus (default 4)")
    ap.add_argument("--step", type=int, default=1, choices=(1, 2, 5),
                    help="tick distance in mm (1, 2 or 5; on small labels use 2)")
    ap.add_argument("--N", type=float, help="mm reading on the north edge")
    ap.add_argument("--Z", type=float, help="mm reading on the south edge")
    ap.add_argument("--W", type=float, help="mm reading on the west edge")
    ap.add_argument("--O", type=float, help="mm reading on the east edge")
    ap.add_argument("--markers", action="store_true",
                    help="print the T/B/L/R frame sheet instead of the cross "
                         "(lesson §4A: one letter per corner, no numbers)")
    ap.add_argument("--report", type=float, default=None,
                    help="bij plumb: afwijking in mm (positief = lijn op A); "
                         "rekent direct de nieuwe xoffset uit")
    ap.add_argument("--T", type=float, help="mm of white between frame and top edge (corner T)")
    ap.add_argument("--B", type=float, help="mm of white between frame and bottom edge (corner B)")
    ap.add_argument("--L", type=float, help="mm of white between frame and left edge (corner L)")
    ap.add_argument("--R", type=float, help="mm of white between frame and right edge (corner R)")
    ap.add_argument("--host", default=os.environ.get("LW_HOST", DEFAULT_HOST))
    ap.add_argument("--port", type=int, default=int(os.environ.get("LW_PORT", 9100)))
    ap.add_argument("--preview", metavar="FILE.png", help="schrijf het beeld, niet printen")
    ap.add_argument("--dry-run", action="store_true", help="TSPL bouwen, niet versturen")
    ap.add_argument("--state", default=DEFAULT_STATE,
                    help="file holding the measure data (default /tmp/lw650xl-measure.json)")
    args = ap.parse_args()

    # ./measure 36 89  |  ./measure solve --N .. 
    args.mode = "print"
    numbers = []
    for tok in args.positionals:
        if tok in ("solve", "ladder", "plumb"):
            args.mode = tok
        else:
            try:
                numbers.append(float(tok))
            except ValueError:
                ap.exit(f"unrecognized argument: {tok}")
    args.w = numbers[0] if len(numbers) > 0 else None
    args.h = numbers[1] if len(numbers) > 1 else None

    if args.mode == "plumb":
        if not args.w or not args.h:
            ap.exit("usage: ./measure plumb <block_width> <height> "
                    "[--name LW_XxY | --xoffset .. --pitch ..] [--report <mm>]")
        return cmd_plumb(lw, args)

    if args.mode == "ladder":
        if not args.w or not args.h:
            ap.exit("usage: ./measure ladder <width_mm> <height_mm> --pitch <mm>")
        if args.pitch is None:
            args.pitch = args.h + (args.gap if args.gap is not None else 3.0)
        return cmd_ladder(lw, args)

    if args.mode == "solve":
        if not any(getattr(args, k) is not None for k in "TBLR"):
            missing = [k for k in "NZWO" if getattr(args, k) is None]
            if missing:
                sys.exit("give all four readings: "
                         + " ".join(f"--{k} <mm>" for k in missing)
                         + "  (or --T --B --L --R after a marker sheet)")
        if args.voffset is None:
            args.voffset = 0.0
        return cmd_solve(lw, args)

    if not args.w or not args.h:
        ap.exit("usage: ./measure <width_mm> <height_mm> [--markers] [...]  "
                "or  ./measure solve ...")
    if args.markers:
        return cmd_markers(lw, args)
    return cmd_print(lw, args)


if __name__ == "__main__":
    sys.exit(main())
