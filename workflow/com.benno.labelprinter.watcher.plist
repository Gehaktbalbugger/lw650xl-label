<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.benno.labelprinter.watcher</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__SCRIPT__</string>
    </array>

    <key>UserName</key>
    <string>__USER__</string>
    <key>GroupName</key>
    <string>staff</string>

    <key>WatchPaths</key>
    <array>
        <string>/Users/Shared/Labelprinter/inbox</string>
    </array>
    <key>StartInterval</key>
    <integer>60</integer>
    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/Shared/Labelprinter/logs/watcher.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/Shared/Labelprinter/logs/watcher.err.log</string>

    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
