#!/usr/bin/env python3
"""label - print labels on the LW650XL PRO (Aimo 650, TSPL over TCP 9100).

Examples:
  label "Anna de Bakker\nKeukenstraat 12\n1011 AB Amsterdam"
  label "Pakket #1234" --size 104x159 --font 60 --qr "https://track.example/1234"
  label "Sale" --barcode "CODE128:ABC123" --copies 3
  label "Test" --preview out.png        # render only, do not print
"""
import argparse
import math
import os
import re
import socket
import sys

DEFAULT_HOST = "172.16.1.20"
DEFAULT_PORT = 9100
DEFAULT_SIZE = "57x32"    # mm, the AM11354 labels loaded in the printer
DEFAULT_PITCH = 38.6      # mm, label + gap/liner (what SIZE expects)
DEFAULT_VOFFSET = 0.34    # mm, moves the print down the label (centring)
DEFAULT_DPI = 300

# Printer geometry, measured on the hardware (see cups/lw650xl.py):
# the bitmap maps 1:1 onto the 1280-dot head, the label top edge is 60 dots
# below the bitmap origin, and 2 mm of the label lies left of bitmap x=0.
HEAD_DOTS = 1280
TOP_OFFSET_DOTS = 60
LEFT_MARGIN_DOTS = 24
RIGHT_SAFETY_DOTS = 9
BOTTOM_SAFETY_DOTS = 8
DOTS_PER_MM = 300.0 / 25.4
DEFAULT_LEFT_MM = LEFT_MARGIN_DOTS / DOTS_PER_MM     # ~2.0 mm dead zone
DEFAULT_TOP_MM = TOP_OFFSET_DOTS / DOTS_PER_MM       # ~5.1 mm below origin
DEFAULT_BOTTOM_MM = BOTTOM_SAFETY_DOTS / DOTS_PER_MM  # ~0.7 mm shy of the edge
DEFAULT_RIGHT_MM = RIGHT_SAFETY_DOTS / DOTS_PER_MM     # ~0.8 mm shy of the edge

FONT_CANDIDATES = [
    "/System/Library/Fonts/Supplemental/Arial Bold.ttf",
    "/System/Library/Fonts/Supplemental/Arial.ttf",
    "/System/Library/Fonts/Helvetica.ttc",
]


def parse_size(s):
    try:
        w, h = s.lower().split("x")
        return float(w), float(h)
    except ValueError:
        sys.exit(f"bad --size {s!r}, expected like 57x32 (mm)")


# The PPD written by add-size.sh is the catalog of label rolls: each size
# records its feed pitch and gap as a comment CUPS preserves.
PPD_CANDIDATES = (
    "/etc/cups/ppd/LW650XL_Labels.ppd",
    os.path.join(os.path.dirname(os.path.abspath(__file__)),
                 "cups", "lw650xl-labels.ppd"),
)


GEOMETRY_KEYS = ("pitch", "gap", "gapoff", "voffset", "left", "right", "top",
              "bottom", "rows", "rotate", "sense", "xoffset")


def media_from_ppd(size_w, size_h):
    """{pitch, gap, voffset} recorded for this label size, or {}."""
    name = f"LW_{size_w:g}x{size_h:g}"
    for path in PPD_CANDIDATES:
        try:
            with open(path, "r", errors="replace") as f:
                text = f.read()
        except OSError:
            continue
        m = re.search(rf"^\*%\s*lw-media\s+{re.escape(name)}\s+(.*)$", text, re.M)
        if not m:
            continue
        found = {}
        for tok in m.group(1).split():
            key, _, value = tok.partition("=")
            if key not in GEOMETRY_KEYS:
                continue
            if key == "sense":
                found[key] = value
                continue
            try:
                found[key] = float(value)
            except ValueError:
                pass
        return found
    return {}


def load_font(pt):
    from PIL import ImageFont
    for path in FONT_CANDIDATES:
        try:
            return ImageFont.truetype(path, pt)
        except OSError:
            continue
    return ImageFont.load_default()


def wrap_lines(draw, text, font, max_px):
    """Wrap text to width, honouring explicit \n."""
    lines = []
    for para in text.split("\n"):
        words = para.split()
        if not words:
            lines.append("")
            continue
        cur = words[0]
        for w in words[1:]:
            trial = cur + " " + w
            if draw.textlength(trial, font=font) <= max_px:
                cur = trial
            else:
                lines.append(cur)
                cur = w
        lines.append(cur)
    return lines


def fit_font(draw, text, font_pt, max_w, max_h, line_spacing=1.15):
    """Shrink font until the wrapped text block fits the box."""
    pt = font_pt
    while pt > 6:
        font = load_font(pt)
        lines = wrap_lines(draw, text, font, max_w)
        asc, desc = font.getmetrics()
        lh = int((asc + desc) * line_spacing)
        if len(lines) * lh <= max_h and all(draw.textlength(l, font=font) <= max_w for l in lines):
            return font, lines, lh
        pt = int(pt * 0.9)
    font = load_font(12)
    asc, desc = font.getmetrics()
    return font, wrap_lines(draw, text, font, max_w), int((asc + desc) * 1.15)


def content_box(size_w, size_h, left_mm=DEFAULT_LEFT_MM, top_mm=DEFAULT_TOP_MM,
                voffset_mm=0.0, pitch_mm=None, bottom_mm=DEFAULT_BOTTOM_MM,
                right_mm=DEFAULT_RIGHT_MM, rows=None, xoffset_mm=0.0):
    """Label's print window in dots: (origin_y, width, height).

    `left_mm` is the dead zone between the label edge and the start of the
    head, `top_mm` where the label starts below the bitmap origin and
    `voffset_mm` nudges the print down for centring. When the pitch is known
    the height is clamped to the canvas: the printer anchors the bitmap at
    its bottom edge, so a taller canvas would move the whole print.
    """
    ox = int(round(xoffset_mm * DOTS_PER_MM))   # may be negative: the liner
    # then starts left of head-x=0; that strip is unreachable and gets
    # clipped when pasting onto the canvas (PIL paste and the filter do that).
    cw = (int(round(size_w * DOTS_PER_MM)) - int(round(left_mm * DOTS_PER_MM))
          - int(round(right_mm * DOTS_PER_MM)))
    ch = int(round(size_h * DOTS_PER_MM)) - int(round(bottom_mm * DOTS_PER_MM))
    oy = max(0, int(round((top_mm + voffset_mm) * DOTS_PER_MM)))
    cw = max(1, min(cw, HEAD_DOTS))
    if pitch_mm:
        canvas = int(rows) if rows else int(round(pitch_mm * DOTS_PER_MM)) - 12
        ch = min(ch, canvas - oy)
    return ox, oy, max(1, ch), max(1, min(cw, HEAD_DOTS - max(0, ox)))


def render_label(args, dots_mm):
    """Render text (+optional logo) to a 1-bit PIL image covering the label."""
    from PIL import Image, ImageDraw
    _ox, _oy, h_px, w_px = args.box
    img = Image.new("1", (w_px, h_px), 1)  # 1 = white
    draw = ImageDraw.Draw(img)
    margin = int(args.margin * dots_mm)

    # optional logo in the top-right corner
    logo_w = 0
    if args.logo:
        logo = Image.open(args.logo).convert("L").point(lambda p: 0 if p < 128 else 255)
        max_h = int(args.logo_h * dots_mm)
        max_w = int(args.logo_w * dots_mm)
        scale = min(max_w / logo.width, max_h / logo.height, 1.0)
        logo = logo.resize((max(1, int(logo.width * scale)), max(1, int(logo.height * scale))))
        img.paste(logo, (w_px - margin - logo.width, margin))
        logo_w = logo.width + margin

    # text area: leave room on the right for a native QR, and at the bottom for a barcode
    qr_w = int(30 * dots_mm) + margin if args.qr else 0
    bar_h = int(15 * dots_mm) + margin if args.barcode else 0
    box_w = w_px - 2 * margin - qr_w - logo_w
    box_h = h_px - 2 * margin - bar_h
    font_pt = max(12, int(args.font * 2.835))  # mm -> pt (1 mm = 2.835 pt)
    font, lines, lh = fit_font(draw, args.text, font_pt, box_w, box_h)

    asc, desc = font.getmetrics()
    y = margin
    if args.top:
        y = int(args.top * dots_mm)
    for line in lines:
        draw.text((margin, y), line, font=font, fill=0)  # 0 = black = print
        y += lh

    return img


def to_preview_png(img, path):
    img.convert("L").save(path)


def tspl_sensor(gap_mm, sense, gapoff_mm=0.0):
    """GAP for clear liner between labels, BLINE for marks/holes in it.

    The second number is the liner between the label's trailing edge and the
    start of the gap/mark: this roll has 4 mm of plain liner before its 3 mm
    notch, which the printer needs or it hunts for the wrong edge.
    """
    return f"{(sense or 'gap').upper()} {gap_mm:g} mm,{gapoff_mm:g} mm"


def build_tspl(args, img, dots_mm):
    """Compose the label into a full-head bitmap and build the TSPL job.

    Verified against the printer (and the vendor app):
      - BITMAP mode 0 = uncompressed, payload right after the last comma,
        no length field and no CRLF before the binary data.
      - bit 1 = WHITE, bit 0 = printed dot.
      - the bitmap is mapped 1:1 on the 1280-dot head and anchored at its
        BOTTOM edge, so it must be padded to the full feed height.
    """
    from PIL import Image

    bpr = HEAD_DOTS // 8
    target_h = int(args.rows) if args.rows else int(round(args.pitch * DOTS_PER_MM)) - 12
    _ox, oy = args.box[0], args.box[1]
    canvas_h = max(oy + img.height, target_h)
    canvas = Image.new("1", (bpr * 8, canvas_h), 1)
    canvas.paste(img, (_ox, oy))
    bits = canvas.tobytes("raw", "1")   # PIL '1' already packs white = 1

    parts = [
        f"DENSITY {args.density}",
        f"SPEED {args.speed}",
        "REFERENCE 0,0",
        "OFFSET 0 mm",
        f"SIZE {args.size_w:g} mm,{args.pitch:g} mm",
        tspl_sensor(args.gap, getattr(args, "sense", "gap"),
                    getattr(args, "gapoff", 0.0) or 0.0),
        "DIRECTION 0,0",
        "CLS",
    ]
    payload = ("\r\n".join(parts) + "\r\n" +
               f"BITMAP 0,0,{bpr},{canvas_h},0,").encode("ascii")
    payload += bits + b"\r\n"

    if args.qr:
        x = max(0, img.width - int(30 * dots_mm))
        y = oy + max(0, img.height - int(30 * dots_mm))
        payload += f'QRCODE {x},{y},L,8,A,0,"{args.qr}"\r\n'.encode("ascii")
    if args.barcode:
        kind, _, code = args.barcode.partition(":")
        if not code:
            sys.exit("bad --barcode, use --barcode CODE128:YOURDATA")
        x = int(2 * dots_mm)
        y = oy + max(0, img.height - int(12 * dots_mm))
        payload += (
            f'BARCODE {x},{y},"{kind}",{int(12 * dots_mm)},2,4,0,1,100,"{code}"\r\n'
        ).encode("ascii")
    payload += f"PRINT {args.copies},1\r\n".encode("ascii")
    return payload


def send(host, port, payload):
    with socket.create_connection((host, port), timeout=10) as s:
        s.sendall(b"\r\n" + payload)  # leading \r\n clears any stale partial line
        s.settimeout(4)
        chunks = []
        try:
            while True:
                b = s.recv(4096)
                if not b:
                    break
                chunks.append(b)
        except socket.timeout:
            pass
        resp = b"".join(chunks)
        if resp:
            print("printer:", resp.decode("latin-1")[:500])


def main():
    p = argparse.ArgumentParser(description="Print a label on the LW650XL PRO.")
    p.add_argument("text", help="label text; use \\n for new lines")
    p.add_argument("--host", default=DEFAULT_HOST)
    p.add_argument("--port", type=int, default=DEFAULT_PORT)
    p.add_argument("--size", default=DEFAULT_SIZE, help="WxH in mm (default 57x32)")
    p.add_argument("--pitch", type=float,
                   help="feed height in mm, label + gap/liner "
                        "(default: from the PPD, else height + gap)")
    p.add_argument("--font", type=float, default=8.0, help="max text height in mm (default 8)")
    p.add_argument("--margin", type=float, default=2.0, help="margin in mm")
    p.add_argument("--top", type=float, default=0, help="start text N mm from top")
    p.add_argument("--qr", help="QR code data, printed bottom-right")
    p.add_argument("--barcode", help='barcode, e.g. "CODE128:ABC123", bottom-left')
    p.add_argument("--logo", help="PNG path, top-right corner")
    p.add_argument("--logo-w", type=float, default=25, help="max logo width mm")
    p.add_argument("--logo-h", type=float, default=25, help="max logo height mm")
    p.add_argument("--copies", type=int, default=1)
    p.add_argument("--density", type=int, default=15, help="0-15, higher = darker")
    p.add_argument("--speed", type=int, default=1, help="labels per minute-ish")
    p.add_argument("--gap", type=float, default=None,
                   help="label gap in mm (default: from the PPD, else 3)")
    p.add_argument("--voffset", type=float, default=None,
                   help="print this many mm lower on the label (default: from the PPD)")
    p.add_argument("--left", type=float, default=None,
                   help="dead zone left of the head in mm (default: from the PPD, 2)")
    p.add_argument("--media-top", dest="media_top", type=float, default=None,
                   help="label top edge below the bitmap origin in mm (PPD, 5.1); "
                        "negative means part of the label is out of reach")
    p.add_argument("--media-bottom", dest="media_bottom", type=float, default=None,
                   help="keep this many mm free at the label's bottom edge (PPD, 0.7)")
    p.add_argument("--media-right", dest="media_right", type=float, default=None,
                   help="keep this many mm free at the label's right edge (PPD, 0.8)")
    p.add_argument("--two", metavar="TEKST_B", default=None,
                   help="two separate labels side by side on this roll (2-up); for rolls "
                        "with two lanes like the AM11353")
    p.add_argument("--xoffset", type=float, default=None,
                   help="mm between the head start and the liner's left edge (PPD xoffset=)")
    p.add_argument("--rows", type=int, default=None,
                   help="pin the bitmap height in dots (PPD rows=; default pitch-12)")
    p.add_argument("--gapoff", type=float, default=None,
                   help="mm of liner between the label end and the gap/mark (PPD gapoff=)")
    p.add_argument("--sense", choices=("gap", "bline"), default=None,
                   help="media sensor: gap (default) or bline for marked liner")
    p.add_argument("--rotate", type=int, default=None, choices=(0, 90, 270),
                   help="turn the label image: 90 clockwise, 270 counter-clockwise")
    p.add_argument("--dpi", type=int, default=DEFAULT_DPI, help="head resolution")
    p.add_argument("--preview", metavar="FILE.png", help="render to PNG instead of printing")
    args = p.parse_args()

    args.text = args.text.replace("\\n", "\n")
    if args.two:
        args.two = args.two.replace("\\n", "\n")   # csv2labels-documentatie: \n ook in de tweede tekst
    args.size_w, args.size_h = parse_size(args.size)
    # Roll geometry: the PPD written by add-size.sh knows the pitch and gap.
    hints = media_from_ppd(args.size_w, args.size_h)
    known = (args.size_w, args.size_h) == (57.0, 32.0)
    if args.gap is None:
        args.gap = hints.get("gap", 3.0)
    if args.pitch is None:
        if "pitch" in hints:
            args.pitch = hints["pitch"]
        elif known:
            args.pitch = DEFAULT_PITCH
        else:
            args.pitch = args.size_h + args.gap      # die-cut: label + gap
    if args.voffset is None:
        args.voffset = hints.get("voffset", DEFAULT_VOFFSET if known else 0.0)
    if args.left is None:
        args.left = hints.get("left", DEFAULT_LEFT_MM)
    if args.media_top is None:
        args.media_top = hints.get("top", DEFAULT_TOP_MM)
    # args.bottom/args.right have no CLI option of their own: overwrite from
    # --media-bottom/--media-right, else the PPD hint, else the default.
    args.bottom = None
    args.right = None
    if args.bottom is None:
        args.bottom = (args.media_bottom if args.media_bottom is not None
                       else hints.get("bottom", DEFAULT_BOTTOM_MM))
    if args.right is None:
        args.right = (args.media_right if args.media_right is not None
                      else hints.get("right", DEFAULT_RIGHT_MM))
    if args.rows is None:
        args.rows = hints.get("rows")
    # Eerst de rol-hints uit de PPD, DAN het printvlak: die volgorde is nu verkeerd
    if args.sense is None:
        args.sense = hints.get("sense", "gap")
    if args.gapoff is None:
        args.gapoff = hints.get("gapoff", 0.0)
    if args.xoffset is None:
        args.xoffset = hints.get("xoffset", 0.0)

    args.box = content_box(args.size_w, args.size_h, args.left, args.media_top,
                           args.voffset, args.pitch, args.bottom, args.right,
                           args.rows, args.xoffset)
    dots_mm = round(args.dpi / 25.4)  # 300 dpi -> 12 dots/mm

    if args.rotate is None:
        args.rotate = int(hints.get("rotate", 0))
    if args.two:
        # 2-up: compose in the DESIGN frame (on this roll 295 × 288 dots),
        # two half pages of 295 × 144 stacked, and only then apply the
        # single-label rotation. The old build ran in canvas coordinates
        # (590 × 287, later 294 upright): half the image fell off the head
        # and the text stood sideways-wrong — hence "a few pixels" on the
        # sheet.
        import copy
        from PIL import Image
        ox, oy, ch, cw = args.box
        rot = args.rotate if args.rotate in (90, 270) else 270  # 2-up always prints sideways
        half = ch // 2
        a2 = copy.copy(args)
        a2.two = None
        a2.box = (ox, oy, half, cw)   # half page: 295 × 144 dots
        a2.text = args.text
        e_boven = render_label(a2, dots_mm)
        a2.text = args.two
        e_onder = render_label(a2, dots_mm)
        img = Image.new("1", (cw, ch), 1)   # the design frame, not the canvas
        img.paste(e_boven, (0, 0))          # top half -> left column after rotation
        img.paste(e_onder, (0, half))       # bottom half -> right column after rotation
        img = img.rotate(-rot, expand=True)
    elif args.rotate in (90, 270):
        # Render the page turned on its side, then rotate it back into the
        # label's print window. Only the design turns; the bitmap keeps
        # running across the 1280-dot head, which is what TSPL BITMAP needs.
        args.box = (args.box[0], args.box[1], args.box[3], args.box[2])
        img = render_label(args, dots_mm)
        img = img.rotate(-args.rotate, expand=True)
    else:
        img = render_label(args, dots_mm)

    if args.preview:
        to_preview_png(img, args.preview)
        print(f"preview written: {args.preview}")
        return

    payload = build_tspl(args, img, dots_mm)
    send(args.host, args.port, payload)
    print(f"sent: {args.text.splitlines()[0]!r}... ({args.size_w}x{args.size_h} mm)")


if __name__ == "__main__":
    main()
